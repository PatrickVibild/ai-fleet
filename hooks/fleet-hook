#!/usr/bin/env python3
"""Claude Code hook for fleet sessions: `fleet-hook ask` (PreToolUse on AskUserQuestion) and `fleet-hook stop` (Stop).

Forwards the hook input to the ai-fleet daemon and prints whatever it decides. If the daemon is down it
fails open (prints nothing), so a session never gets stuck on a missing daemon. If the daemon restarts
mid-wait, the hook reconnects and asks again.
"""
import json
import os
import socket
import sys
import time

SOCK = os.environ.get("AI_FLEET_SOCK") or os.path.join(
    os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}"), "ai-fleet.sock")
RECONNECT_FOR = 120


def ask_daemon(req):
    give_up = time.time() + RECONNECT_FOR
    while True:
        try:
            with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as s:
                s.connect(SOCK)
                s.sendall((json.dumps(req) + "\n").encode())
                buf = b""
                while not buf.endswith(b"\n"):
                    chunk = s.recv(65536)
                    if not chunk:
                        raise ConnectionError("daemon closed the connection")
                    buf += chunk
                return json.loads(buf)
        except (OSError, ConnectionError, json.JSONDecodeError):
            if time.time() > give_up:
                return None
            time.sleep(2)


def main():
    event = sys.argv[1] if len(sys.argv) > 1 else ""
    try:
        hook_input = json.load(sys.stdin)
    except json.JSONDecodeError:
        return
    resp = ask_daemon({"op": "hook", "event": event, "input": hook_input})
    if resp and resp.get("ok") and resp.get("output"):
        print(json.dumps(resp["output"]))


if __name__ == "__main__":
    main()
